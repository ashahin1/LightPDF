            VALUE "OriginalFilename", "LightPDF.exe\0"
            VALUE "ProductName",      "LightPDF\0"
            VALUE "ProductVersion",   "2.0.0.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
